# win.ps1 – Wrapper for ChrisTitusTech's WinUtil
# ---------------------------------------------------
# This script mimics the behaviour of
#   irm https://christitus.com/win | iex
# but pulls the original WinUtil project from GitHub and runs it locally.
# It works on Windows PowerShell 5.1.

# 1. Define temporary folder where we will store the repository
$tempDir = Join-Path $env:TEMP "winutil_temp"
if (-Not (Test-Path $tempDir)) {
    New-Item -ItemType Directory -Path $tempDir | Out-Null
}

# 2. Download the latest release (or master) if not already present
$zipPath = Join-Path $tempDir "winutil.zip"
$repoUrl = "https://github.com/ChrisTitusTech/winutil/archive/refs/heads/main.zip"
if (-Not (Test-Path $zipPath)) {
    Write-Host "Downloading WinUtil repository..." -ForegroundColor Cyan
    try {
        Invoke-WebRequest -Uri $repoUrl -OutFile $zipPath -UseBasicParsing
    } catch {
        Write-Error "Failed to download repository: $_"
        exit 1
    }
}

# 3. Extract the zip (overwrites previous contents)
Write-Host "Extracting repository..." -ForegroundColor Cyan
Expand-Archive -Path $zipPath -DestinationPath $tempDir -Force
# The extracted folder name ends with '-main'
$extracted = Get-ChildItem $tempDir -Directory | Where-Object { $_.Name -like "winutil-*" } | Select-Object -First 1
if (-Not $extracted) {
    Write-Error "Could not locate extracted WinUtil folder."
    exit 1
}

# 4. Import the main script (the repo ships a single file WinUtil.ps1)
$mainScript = Join-Path $extracted.FullName "WinUtil.ps1"
if (-Not (Test-Path $mainScript)) {
    Write-Error "Main script WinUtil.ps1 not found in extracted folder."
    exit 1
}

# 5. Dot‑source the script so its functions become available
Write-Host "Importing WinUtil script..." -ForegroundColor Cyan
. $mainScript

# 6. Launch the GUI (the original repo defines a function 'Show-WinUtil' that creates the UI)
# If the function name changes, adjust accordingly.
if (Get-Command -Name Show-WinUtil -ErrorAction SilentlyContinue) {
    Write-Host "Launching WinUtil UI..." -ForegroundColor Green
    Show-WinUtil
} else {
    Write-Warning "Show-WinUtil function not found. Attempting to run the default entry point.
";
    # Many forks expose a function named 'Start-WinUtil' – try that as fallback
    if (Get-Command -Name Start-WinUtil -ErrorAction SilentlyContinue) {
        Start-WinUtil
    } else {
        Write-Error "Unable to locate entry point in WinUtil script."
    }
}

# 7. Clean up (optional): you may want to keep the temp folder for faster subsequent runs.
# Uncomment the next line to delete everything after the UI closes.
